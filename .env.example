# Verixa (consolidated: Deliverable 1 + the completed Deliverable 2 risk scoring)
# Copy to .env and fill in. One file serves the app and the Analysis Agent.
# Never commit .env. .gitignore already excludes it.

# ---------------------------------------------------------------------------
# The app (Deliverable 1)
# ---------------------------------------------------------------------------

# The public address of this app: your ngrok domain. OAuth callbacks and the webhook URL are built
# from it. Sign up and log in also work on http://localhost:8000, but GitHub, Atlassian and the
# webhook only work through the public address.
PUBLIC_URL=https://YOUR-TUNNEL.ngrok-free.app

# Long random strings. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY signs the session cookie and encrypts stored GitHub and Atlassian tokens. Changing it
# makes every stored token unreadable.
SECRET_KEY=
# WEBHOOK_SECRET is what GitHub signs every delivery with. Changing it breaks existing webhooks.
WEBHOOK_SECRET=

# Neon PostgreSQL, shared by the app and the agent. Paste the POOLED string as Neon gives it
# (host contains -pooler). For a local database from docker compose:
#   postgresql+psycopg://verixa:verixa@localhost:5432/verixa
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Encrypts two-step verification secrets, separately from SECRET_KEY.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# Email for "Forgot password" links. Leave SMTP_HOST empty while testing on your own computer: the link is then
# printed in the server window instead of being emailed. For Gmail, use smtp.gmail.com, port 587, your Gmail
# address, and an app password (Google account > Security > 2-Step Verification > App passwords), not your
# normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ---------------------------------------------------------------------------
# Analysis Agent (Deliverable 2)
# ---------------------------------------------------------------------------

# At least one provider key is needed for the agent to write the reasoning and the test areas.
# The risk LABEL and SCORE are computed by rules in agents/risk_rules.py and need no key at all.
# A model without a key is skipped, and the chain moves on to the next one.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# GEMINI_API_KEY=         # last fallback only. Its free tier may train on inputs, so do not set
#                         # this if real repository code must not be sent to Gemini.

# Model chain for the analysis explanation, comma separated and tried in order.
# Leave unset to use the defaults in agents/llm.py (the priority table in docs/MODELS.md).
# ANALYSIS_MODELS=groq/openai/gpt-oss-20b,groq/openai/gpt-oss-120b,openrouter/qwen/qwen3-8b

# Extra words that mark changed code as sensitive for risk scoring (comma separated).
# HIGH_RISK_KEYWORDS=ledger,kyc
# MEDIUM_RISK_KEYWORDS=report,export

# Fallback GitHub token for scripts and local testing only. In the running app the agent uses the
# signed-in account's own OAuth token from users.github_token, not this.
# GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# Unset, the test suite uses a temporary SQLite file and never touches DATABASE_URL.
# Point this at a throwaway database (a separate Neon branch) to run the tests on PostgreSQL.
# Never point it at production: the tests drop and recreate every table.
# TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Agent trace log (see AGENT_TESTING.md)
# ---------------------------------------------------------------------------
# Defaults to logs/agent_trace.jsonl. Leave empty to turn the file off.
# AGENT_TRACE_FILE=
# Set to 0 to keep the trace out of the server console.
# AGENT_TRACE_CONSOLE=1

# ---------------------------------------------------------------------------
# Agent time limits, in seconds
# ---------------------------------------------------------------------------
# One model's answer. After this the next model in the chain is tried.
# AGENT_MODEL_TIMEOUT=60
# A whole run, across every attempt and model. After this the row is marked failed.
# AGENT_RUN_TIMEOUT=300

# ---------------------------------------------------------------------------
# Test runs, tickets and QA Memory (UC4 to UC11). All optional: the defaults are shown.
# ---------------------------------------------------------------------------
# How often the Manager sends an agent's work back before a person must look (TBD3). Read by every agent.
# AGENT_MAX_ATTEMPTS=3
# A whole run is stopped after this many seconds, and one Playwright test after this many milliseconds.
# RUN_TIMEOUT_SECONDS=600
# TEST_TIMEOUT_MS=30000
# Runs each account may start per hour.
# MAX_RUNS_PER_HOUR=20
# Allow a staging app on this computer or the local network (127.0.0.1, 192.168.x.x). Cloud metadata addresses are
# always refused. Set to false on a public server.
# ALLOW_PRIVATE_STAGING=true
# Model chain for the Report Agent's ticket text (comma separated, tried in order). Fixes and drafted tests use DRAFT_MODELS.
# REPORT_MODELS=groq/openai/gpt-oss-120b,groq/openai/gpt-oss-20b
# QA Memory. Empty EMBEDDING_MODEL keeps a local word vector, so no failure text leaves the server.
# EMBEDDING_MODEL=gemini/text-embedding-004
# EMBEDDING_DIM=256
# MEMORY_TOP_K=5
# MEMORY_MIN_SIMILARITY=0.35
# Trends need at least this many scored pull requests (TBD17).
# TREND_MIN_PULL_REQUESTS=3
